{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/config.schema.json",
  "productName": "DMS Sync",
  "version": "1.4.1",
  "identifier": "id.arsipin.dms-sync",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "DMS Sync",
        "width": 600,
        "height": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "closable": true,
        "minimizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "frameworks": []
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU0MkVDQzNFNTA0NTUyODMKUldTRFVrVlFQc3d1NU1iTVVqdjBGVFdtMUZHWWh4cVpkSm8rWDRzZHdxbWVlSSsxOHBhajBBNWgK",
      "endpoints": [
        "https://github.com/mteguhfh/DMS-Arsipin-Sync/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
